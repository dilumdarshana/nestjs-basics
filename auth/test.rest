# =====================================================================
# auth — REST Client examples
# =====================================================================
# How to use:
#  1. Install the "REST Client" extension in VS Code.
#  2. Start the app:  pnpm start:auth   (from the repo root)
#  3. Run a request by clicking "Send Request" above it.
#
# Flow: signup -> signin -> copy the accessToken/refreshToken you get
# from signin, then paste them into the placeholders below.
# =====================================================================


# ---------------------------------------------------------------------
# 1. SIGNUP — create a new user.
#    Always assigns the "user" role (role_id in the body is ignored).
#    Expect: 201 { "message": "User created successfully" }
#    Note:   running it twice with the same email -> 409 Conflict.
# ---------------------------------------------------------------------
POST http://localhost:3000/auth/signup
Content-Type: application/json

{
  "email": "alex@example.com",
  "password": "1qaz!QAZ",
  "name": "Alex"
}

###


# ---------------------------------------------------------------------
# 2. SIGNIN — exchange email + password for tokens.
#    Returns: { ..., "accessToken": "...", "refreshToken": "..." }
#    Copy BOTH tokens from the response and paste them into the
#    requests below (whoami / refresh-token / admin role).
#    (The Authorization header here is NOT needed — remove it.)
# ---------------------------------------------------------------------
POST http://localhost:3000/auth/signin
Content-Type: application/json

{
  "username": "alex@example.com",
  "password": "1qaz!QAZ"
}

###


# ---------------------------------------------------------------------
# 3. WHOAMI — current user (protected by JwtAuthGuard).
#    Send the ACCESS token you got from signin.
#    Expect: 200 { "id": ..., "name": "...", "email": "...",
#                  "role_id": 2, "role": "user" }
#    No token / bad token -> 401.
# ---------------------------------------------------------------------
GET http://localhost:3000/auth/whoami
Authorization: Bearer <PASTE_ACCESS_TOKEN>

###


# ---------------------------------------------------------------------
# 4. REFRESH TOKEN — get a new token pair from the REFRESH token.
#    Note: the refresh token goes in the JSON body field "refresh",
#    NOT in an Authorization header (see jwt.refresh.strategy.ts).
#    Expect: 201 { ..., "accessToken": "...", "refreshToken": "..." }
# ---------------------------------------------------------------------
POST http://localhost:3000/auth/refresh-token
Content-Type: application/json

{
  "refresh": "<PASTE_REFRESH_TOKEN>"
}

###


# ---------------------------------------------------------------------
# 5. CREATE ROLE (RBAC demo) — requires an ADMIN access token.
#    If you sign in as a "user" role you get: 403 Forbidden resource.
#    To get an admin token: run `pnpm db:admin` (creates
#    admin@example.com / 1qaz!QAZ) then sign in with it.
#    Expect: 201 { "id": ..., "name": "moderator", ... }
# ---------------------------------------------------------------------
POST http://localhost:3000/admin/role
Content-Type: application/json
Authorization: Bearer <PASTE_ADMIN_ACCESS_TOKEN>

{
  "name": "moderator"
}

###


# ---------------------------------------------------------------------
# 6. GET USER BY ID — public route (no auth required).
#    Expect: 200 with the user row.
#    NOTE: the response includes the argon2 password hash — this is a
#    known data-exposure quirk (see auth/README.md "Gotchas").
# ---------------------------------------------------------------------
GET http://localhost:3000/user/1

###
