# dependencies
node_modules/

# build output
dist/
build/

# test coverage
coverage/
.nyc_output/

# logs
*.log
pnpm-debug.log*
npm-debug.log*

# environment files - never commit real env files
.env
.env.*
!.env.example

# databases
*.sqlite
*.sqlite3
carval/*.sqlite

# TypeScript build info
*.tsbuildinfo

# OS
.DS_Store

# IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# TypeORM generated migrations (committed manually via migrations/ dir)
*-migrations.ts

# carval build artifacts emitted next to source (no rootDir, so db/ + migrations/ compile in place)
carval/db/*.js
carval/db/*.d.ts
carval/db/*.js.map
carval/migrations/*.d.ts

# Prisma 7 generated client (auth)
auth/src/generated/
