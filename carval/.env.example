# carval uses envFilePath `.env.${NODE_ENV}` (e.g. .env.development, .env.test)
# Copy this file to .env.development and fill in real values before running.

# Used by the cookie-session middleware (see src/app.module.ts)
COOKIE_KEY=replace-with-a-long-random-string

# Only used when NODE_ENV=production (see db/data-source.ts)
DATABASE_URL=postgres://user:password@localhost:5432/carval
